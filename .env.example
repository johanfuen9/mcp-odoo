# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000

# ── Respaldo con variables de entorno (solo para uso personal) ──────────────
# Si una petición no trae credenciales de Odoo, el servidor usa estas.
# Ponlo en false cuando compartas el conector con otras personas.
ALLOW_ENV_FALLBACK=true
ODOO_URL=https://miempresa.odoo.com
ODOO_API_KEY=
ODOO_DB=

# Token que debe enviar Claude para poder usar el modo de respaldo.
# Si lo dejas vacío, CUALQUIERA que conozca la URL del servidor podrá leer tu Odoo.
# Genera uno largo, por ejemplo: openssl rand -hex 32
MCP_ACCESS_TOKEN=

# ── Límites ─────────────────────────────────────────────────────────────────
ODOO_TIMEOUT_MS=20000
DEFAULT_ROW_LIMIT=500
MAX_ROW_LIMIT=5000
RATE_LIMIT_PER_MINUTE=120
# Cuántos proxies hay delante del servidor (Render = 1). Sirve para leer la IP real.
TRUST_PROXY_HOPS=1

# Modelos permitidos en consulta_avanzada (separados por coma)
ADVANCED_QUERY_MODELS=res.partner,account.move,account.move.line,account.account,sale.order,purchase.order,product.product,stock.quant

# SOLO DESARROLLO: permite que ODOO_URL (la del .env, nunca la de los encabezados)
# apunte a http:// o a una IP privada, para probar contra un Odoo local.
DEV_ALLOW_PRIVATE_ENV_URL=false
