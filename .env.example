# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
# URL pública con la que Claude llega al servidor (sin / al final).
PUBLIC_BASE_URL=https://mcp.midominio.com

# ── OAuth sin base de datos ─────────────────────────────────────────────────
# Llave con la que se cifran los tokens (las claves de Odoo viajan cifradas en ellos).
# Obligatoria. Genera una con: openssl rand -hex 32
# Si la cambias, todos los usuarios deben volver a conectar el conector.
TOKEN_SECRET=
# Para rotar la llave sin desconectar a nadie: pon la anterior aquí durante 90 días.
TOKEN_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=7776000
# Callbacks adicionales permitidos, separados por coma (claude.ai ya está incluido).
OAUTH_EXTRA_REDIRECT_URIS=
# Permite callbacks a localhost (Claude Code y MCP Inspector).
OAUTH_ALLOW_LOOPBACK_REDIRECTS=true

# ── Modo personal (solo para tu uso) ────────────────────────────────────────
# Usa el Odoo de estas variables cuando se presenta MCP_ACCESS_TOKEN
# (como "Authorization: Bearer ..." o en la pantalla de conexión).
ALLOW_ENV_FALLBACK=false
ODOO_URL=https://miempresa.odoo.com
ODOO_API_KEY=
ODOO_DB=
# Mínimo 24 caracteres. Genera uno con: openssl rand -hex 24
MCP_ACCESS_TOKEN=

# ── Límites ─────────────────────────────────────────────────────────────────
ODOO_TIMEOUT_MS=20000
DEFAULT_ROW_LIMIT=500
MAX_ROW_LIMIT=5000
# Claude acepta ~150.000 caracteres por respuesta; se deja margen.
MAX_RESPONSE_CHARS=120000
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Proxies delante del servidor: Coolify (Traefik) = 1; con Cloudflare delante = 2.
TRUST_PROXY_HOPS=1
# Zona horaria para calcular "hoy" en la cartera por edades.
ZONA_HORARIA=America/Bogota

# Modelos permitidos en consulta_avanzada (separados por coma). Vacío = lista por defecto.
ADVANCED_QUERY_MODELS=

# SOLO DESARROLLO: permite que ODOO_URL (la del entorno, nunca la que escribe un
# usuario) apunte a http:// o a una IP privada, para probar con el Odoo simulado.
DEV_ALLOW_PRIVATE_ENV_URL=false
